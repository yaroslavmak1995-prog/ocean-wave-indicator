//@version=5
indicator("Ocean Wave v1.1 — 9-Factor Trend Visualization", shorttitle="Ocean Wave", overlay=true, max_lines_count=500, max_labels_count=500)

// ════════════════════════════════════════════════════════════════
// OCEAN WAVE v1.1 — 9-Factor Trend Visualization
// Ported from Python Nonuple Confirmation Algorithm v6.1
//
// CHANGES v1.1:
// - FIXED confidence double-counting bug (bonuses were counted 2-3x)
// - Confidence now = total_strength + synergy_bonus only
// - Simplified signal label (trend + confidence%)
// - Lite version now uses SAME algorithm as Full (just no tables)
//
// CONCEPT: Replace candlestick pattern reading with colored zones.
// Green = uptrend context, Yellow = neutral, Red = downtrend context.
// 9 indicators fused into 1 signal. Speed of understanding, not prediction.
//
// Based on 5-year backtest (AAPL, TSLA, SPY, GOOGL, NVDA):
// - Average win rate: 45.32% (below random 50%)
// - High confidence does NOT improve accuracy significantly
// - THIS IS A VISUALIZATION TOOL, NOT A SIGNAL SERVICE
// ════════════════════════════════════════════════════════════════

// ─── INPUTS ────────────────────────────────────────────────────

// MA Settings
ma_fast_len = input.int(20, "MA Fast Length", minval=5, maxval=50, group="Moving Averages")
ma_slow_len = input.int(50, "MA Slow Length", minval=10, maxval=200, group="Moving Averages")

// RSI Settings
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50, group="Momentum")
rsi_ob = input.int(70, "RSI Overbought", minval=50, maxval=95, group="Momentum")
rsi_os = input.int(30, "RSI Oversold", minval=5, maxval=50, group="Momentum")

// ADX Settings
adx_len = input.int(14, "ADX Length", minval=5, maxval=50, group="Trend Strength")

// MACD Settings
macd_fast = input.int(12, "MACD Fast", minval=5, maxval=30, group="Momentum")
macd_slow = input.int(26, "MACD Slow", minval=10, maxval=50, group="Momentum")
macd_signal_len = input.int(9, "MACD Signal", minval=3, maxval=20, group="Momentum")

// Bollinger Bands Settings
bb_len = input.int(20, "BB Length", minval=5, maxval=50, group="Volatility")
bb_mult = input.float(2.0, "BB StdDev", minval=0.5, maxval=4.0, step=0.1, group="Volatility")

// Stochastic Settings
stoch_k_len = input.int(14, "Stochastic %K Length", minval=5, maxval=50, group="Oscillator")
stoch_d_len = input.int(3, "Stochastic %D Smoothing", minval=1, maxval=10, group="Oscillator")
stoch_smooth = input.int(3, "Stochastic Smooth", minval=1, maxval=10, group="Oscillator")

// Visualization Settings
show_zones = input.bool(true, "Show Zone Background", group="Visualization")
show_ma = input.bool(true, "Show MA Lines", group="Visualization")
show_confidence = input.bool(true, "Show Confidence Table", group="Visualization")
show_factors = input.bool(true, "Show Factor Table", group="Visualization")
show_signal_label = input.bool(true, "Show Signal Label", group="Visualization")
zone_transparency = input.int(85, "Zone Transparency (0=solid, 100=invisible)", minval=60, maxval=98, group="Visualization")

// ─── CALCULATIONS ──────────────────────────────────────────────

// STEP 1: MA Crossover
ma_fast = ta.sma(close, ma_fast_len)
ma_slow = ta.sma(close, ma_slow_len)
ma_diff_pct = (ma_fast - ma_slow) / ma_slow * 100

// v6.1: Lowered threshold from 1.0% to 0.5%
base_trend = ma_diff_pct > 0.5 ? 1 : ma_diff_pct < -0.5 ? -1 : 0  // 1=uptrend, -1=downtrend, 0=neutral

// STEP 2: Volume Confirmation
avg_volume = ta.sma(volume, 20)
volume_ratio = avg_volume > 0 ? volume / avg_volume : 1.0

volume_bonus = volume_ratio > 2.0 ? 15 : volume_ratio > 1.5 ? 10 : volume_ratio > 1.2 ? 5 : volume_ratio < 0.5 ? -10 : volume_ratio < 0.8 ? -5 : 0

// STEP 3: Momentum Check
momentum_pct = ma_fast > 0 ? (close - ma_fast) / ma_fast * 100 : 0
momentum_bonus = math.abs(momentum_pct) > 3 ? 10 : math.abs(momentum_pct) > 1.5 ? 5 : math.abs(momentum_pct) < 0.5 ? -5 : 0

// Base strength
base_strength = math.abs(ma_diff_pct) * 15
total_strength = math.min(100, math.max(0, base_strength + volume_bonus + momentum_bonus))

// STEP 4: RSI
rsi_value = ta.rsi(close, rsi_len)

rsi_bonus = 0
if rsi_value >= rsi_ob
    rsi_bonus := base_trend == 1 ? -10 : base_trend == -1 ? 15 : 0
else if rsi_value <= rsi_os
    rsi_bonus := base_trend == -1 ? -10 : base_trend == 1 ? 15 : 0
else if rsi_value >= 60
    rsi_bonus := base_trend == 1 ? 5 : base_trend == -1 ? -5 : 0
else if rsi_value <= 40
    rsi_bonus := base_trend == -1 ? 5 : base_trend == 1 ? -5 : 0
else
    rsi_bonus := 0

// STEP 5: ADX
[diplus, diminus, adx_value] = ta.dmi(adx_len, adx_len)

adx_direction = diplus > diminus ? "bullish" : diplus < diminus ? "bearish" : "neutral"
adx_bonus = 0
if adx_value >= 25
    if adx_direction == "bullish" and base_trend == 1
        adx_bonus := 15
    else if adx_direction == "bearish" and base_trend == -1
        adx_bonus := 15
    else if adx_direction != "neutral" and base_trend == 0
        adx_bonus := 5
    else
        adx_bonus := -5
else if adx_value >= 15
    adx_bonus := 0
else
    adx_bonus := -15

// STEP 6: MACD
[macd_line, macd_signal_line, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_signal_len)

macd_crossover = ta.crossover(macd_line, macd_signal_line) ? "bullish" : ta.crossunder(macd_line, macd_signal_line) ? "bearish" : "none"

// MACD trend signal
macd_trend = macd_line > macd_signal_line and macd_line > 0 ? "strong_bullish" : macd_line > macd_signal_line ? "bullish" : macd_line < macd_signal_line and macd_line < 0 ? "strong_bearish" : macd_line < macd_signal_line ? "bearish" : "neutral"

macd_bonus = 0
if macd_trend == "strong_bullish" and base_trend == 1
    macd_bonus := 15
else if macd_trend == "bullish" and base_trend == 1
    macd_bonus := 10
else if macd_trend == "strong_bearish" and base_trend == -1
    macd_bonus := 15
else if macd_trend == "bearish" and base_trend == -1
    macd_bonus := 10
else if macd_trend == "neutral" and base_trend == 0
    macd_bonus := 3
else
    macd_bonus := -10

// STEP 7: ATR
atr_value = ta.atr(14)

// ATR as % of price
atr_pct = atr_value / close * 100

atr_bonus = 0
if atr_pct > 5.0
    atr_bonus := -15  // Extreme volatility
else if atr_pct > 3.0
    atr_bonus := -8   // High volatility
else if atr_pct < 1.0
    atr_bonus := 3    // Low volatility, stable
else
    atr_bonus := 0

atr_trend = atr_value > atr_value[1] ? "rising" : atr_value < atr_value[1] ? "falling" : "stable"

if atr_trend == "rising" and base_trend != 0
    atr_bonus := atr_bonus - 3
else if atr_trend == "falling" and base_trend != 0
    atr_bonus := atr_bonus + 2

// STEP 8: Bollinger Bands
bb_basis = ta.sma(close, bb_len)
bb_dev = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

bb_range = bb_upper - bb_lower
bb_percent_b = bb_range > 0 ? (close - bb_lower) / bb_range : 0.5
bb_bandwidth = bb_basis > 0 ? bb_range / bb_basis * 100 : 0

// BB squeeze detection
bb_squeeze = bb_bandwidth < 3 ? "extreme" : bb_bandwidth < 5 ? "tight" : bb_bandwidth > 10 ? "expanding" : "normal"

bb_bonus = 0
// Price at band extremes = lower confidence
if bb_percent_b >= 1.0 or bb_percent_b <= 0.0
    bb_bonus := -8
else if bb_percent_b >= 0.85 or bb_percent_b <= 0.15
    bb_bonus := -3

// Squeeze = uncertainty
if bb_squeeze == "extreme" or bb_squeeze == "tight"
    bb_bonus := bb_bonus - 5
else if bb_squeeze == "expanding" and base_trend != 0
    bb_bonus := bb_bonus + 4

// %B confirms trend
if (base_trend == 1 and bb_percent_b > 0.6) or (base_trend == -1 and bb_percent_b < 0.4)
    bb_bonus := bb_bonus + 3

// STEP 9: Stochastic Oscillator
stoch_range = ta.highest(high, stoch_k_len) - ta.lowest(low, stoch_k_len)
stoch_k_raw = stoch_range > 0 ? 100 * (close - ta.lowest(low, stoch_k_len)) / stoch_range : 50
stoch_k = ta.sma(stoch_k_raw, stoch_smooth)
stoch_d = ta.sma(stoch_k, stoch_d_len)

stoch_crossover = ta.crossover(stoch_k, stoch_d) ? "bullish" : ta.crossunder(stoch_k, stoch_d) ? "bearish" : "none"

stoch_signal = stoch_k >= 80 ? "overbought" : stoch_k <= 20 ? "oversold" : stoch_k >= 60 ? "bullish" : stoch_k <= 40 ? "bearish" : "neutral"

stoch_bonus = 0
if stoch_signal == "overbought" and base_trend == 1
    stoch_bonus := -4  // Uptrend may be overextended
else if stoch_signal == "oversold" and base_trend == -1
    stoch_bonus := -4  // Downtrend may be overextended
else if stoch_signal == "neutral"
    stoch_bonus := 2
else if (base_trend == 1 and stoch_k > 50) or (base_trend == -1 and stoch_k < 50)
    stoch_bonus := 3  // Stochastic confirms direction
else if (base_trend == 1 and stoch_k < 30) or (base_trend == -1 and stoch_k > 70)
    stoch_bonus := -4  // Stochastic contradicts

if stoch_crossover == "bullish" and (base_trend == 1 or base_trend == 0)
    stoch_bonus := stoch_bonus + 3
else if stoch_crossover == "bearish" and (base_trend == -1 or base_trend == 0)
    stoch_bonus := stoch_bonus + 3

// ════════════════════════════════════════════════════════════════
// AGGREGATION (v1.1 — NO DOUBLE-COUNTING)
// ════════════════════════════════════════════════════════════════

// Total Strength: sum of all factor bonuses (each counted ONCE)
total_strength := math.min(100, math.max(0, total_strength + rsi_bonus + adx_bonus + macd_bonus + atr_bonus + bb_bonus + stoch_bonus))

// ─── Synergy Bonus ─────────────────────────────────────────────

agree_count = 0
// RSI agrees?
if base_trend == 1 and rsi_value >= 50
    agree_count := agree_count + 1
else if base_trend == -1 and rsi_value <= 50
    agree_count := agree_count + 1

// ADX agrees?
if (base_trend == 1 and adx_direction == "bullish") or (base_trend == -1 and adx_direction == "bearish")
    agree_count := agree_count + 1

// MACD agrees?
macd_agrees = (base_trend == 1 and macd_trend == "strong_bullish") or (base_trend == 1 and macd_trend == "bullish") or (base_trend == -1 and macd_trend == "strong_bearish") or (base_trend == -1 and macd_trend == "bearish")
if macd_agrees
    agree_count := agree_count + 1

// ATR agrees? (stable/falling volatility supports trend)
if atr_pct <= 3.0 and base_trend != 0
    agree_count := agree_count + 1

// BB agrees?
if (base_trend == 1 and bb_percent_b > 0.5) or (base_trend == -1 and bb_percent_b < 0.5)
    agree_count := agree_count + 1

// Stochastic agrees?
if (base_trend == 1 and stoch_k > 50) or (base_trend == -1 and stoch_k < 50)
    agree_count := agree_count + 1

synergy_bonus = agree_count >= 4 ? 10 : 0

// ─── Confirmation Count & Confidence Floor ──────────────────────

confirmation_count = 0
if rsi_bonus >= 0
    confirmation_count := confirmation_count + 1
if adx_bonus >= 0
    confirmation_count := confirmation_count + 1
if macd_bonus >= 0
    confirmation_count := confirmation_count + 1
if atr_bonus >= 0
    confirmation_count := confirmation_count + 1
if bb_bonus >= 0
    confirmation_count := confirmation_count + 1
if stoch_bonus >= 0
    confirmation_count := confirmation_count + 1

// Confidence Floor: boost strength when many confirmations agree
if confirmation_count >= 3 and base_trend != 0
    total_strength := math.min(100, total_strength + 10)
if confirmation_count >= 5 and base_trend != 0
    total_strength := math.min(100, total_strength + 15)

// ─── Zone Color ─────────────────────────────────────────────────

zone_color = base_trend == 1 ? (total_strength >= 70 ? 2 : 1) : base_trend == -1 ? (total_strength >= 70 ? -2 : -1) : 0
// 2 = strong_green, 1 = light_green, 0 = yellow, -1 = light_red, -2 = red

// ════════════════════════════════════════════════════════════════
// CONFIDENCE CALCULATION (v1.1 — FIXED: NO DOUBLE-COUNTING)
// ════════════════════════════════════════════════════════════════

// v1.1: Confidence = total_strength + synergy_bonus only.
// Each indicator bonus is counted EXACTLY ONCE (in total_strength above).
// No more re-adding RSI/ADX/MACD/ATR/BB/Stoch adjustments.
confidence = math.min(100, math.max(0, total_strength + synergy_bonus))

// v6.1: Confidence Floor (unchanged)
if confirmation_count >= 3 and base_trend != 0
    confidence := math.max(confidence, 25)
if confirmation_count >= 5 and base_trend != 0
    confidence := math.max(confidence, 50)

confidence := math.min(100, math.max(0, confidence))

// ─── Signal Generation ─────────────────────────────────────────

signal_text = base_trend == 1 ? (total_strength >= 80 and volume_ratio > 1.5 ? "Strong Uptrend" : total_strength >= 60 ? "Moderate Uptrend" : "Weak Uptrend") : base_trend == -1 ? (total_strength >= 80 and volume_ratio > 1.5 ? "Strong Downtrend" : total_strength >= 60 ? "Moderate Downtrend" : "Weak Downtrend") : (total_strength < 30 ? "Consolidation" : "Ranging")

// ─── VISUALIZATION ──────────────────────────────────────────────

// Zone Background Colors
green_color = color.new(#22c55e, zone_transparency)
light_green_color = color.new(#86efac, zone_transparency)
yellow_color = color.new(#fbbf24, zone_transparency)
light_red_color = color.new(#fca5a5, zone_transparency)
red_color = color.new(#ef4444, zone_transparency)

// Background fill based on zone
zone_bg = zone_color == 2 ? green_color : zone_color == 1 ? light_green_color : zone_color == 0 ? yellow_color : zone_color == -1 ? light_red_color : red_color

bgcolor(show_zones ? zone_bg : na, title="Zone Background")

// MA Lines
plot(show_ma ? ma_fast : na, "MA Fast", color=color.new(#22c55e, 30), linewidth=2)
plot(show_ma ? ma_slow : na, "MA Slow", color=color.new(#ef4444, 30), linewidth=2)

// Bollinger Bands (thin lines)
plot(show_ma ? bb_upper : na, "BB Upper", color=color.new(#94a3b8, 60), linewidth=1)
plot(show_ma ? bb_lower : na, "BB Lower", color=color.new(#94a3b8, 60), linewidth=1)

// ─── Factor Table (top-right) ────────────────────────────────────

if show_factors and barstate.islast
    var table factors = table.new(position.top_right, 2, 13, bgcolor=color.new(#1e293b, 10), border_color=color.new(#475569, 50), border_width=1)
    
    // Header
    table.cell(factors, 0, 0, "🌊 Ocean Wave v1.1", text_color=color.new(#f8fafc, 0), text_size=size.normal, bgcolor=color.new(#0f172a, 10))
    table.merge_cells(factors, 0, 0, 1, 0)
    
    // Trend
    trend_emoji = base_trend == 1 ? "🟢" : base_trend == -1 ? "🔴" : "🟡"
    trend_text = base_trend == 1 ? "UPTREND" : base_trend == -1 ? "DOWNTREND" : "NEUTRAL"
    table.cell(factors, 0, 1, trend_emoji + " Trend", text_color=color.new(#f8fafc, 0), text_size=size.small)
    table.cell(factors, 1, 1, trend_text, text_color=base_trend == 1 ? color.new(#22c55e, 0) : base_trend == -1 ? color.new(#ef4444, 0) : color.new(#fbbf24, 0), text_size=size.small)
    
    // Confidence (v1.1: confidence is the primary metric)
    table.cell(factors, 0, 2, "🎯 Confidence", text_color=color.new(#f8fafc, 0), text_size=size.small)
    table.cell(factors, 1, 2, str.tostring(confidence, "#") + "%", text_color=confidence >= 50 ? color.new(#22c55e, 0) : confidence >= 25 ? color.new(#fbbf24, 0) : color.new(#ef4444, 0), text_size=size.small)
    
    // Strength
    table.cell(factors, 0, 3, "💪 Strength", text_color=color.new(#f8fafc, 0), text_size=size.small)
    table.cell(factors, 1, 3, str.tostring(total_strength, "#") + "%", text_color=total_strength >= 70 ? color.new(#22c55e, 0) : total_strength >= 40 ? color.new(#fbbf24, 0) : color.new(#ef4444, 0), text_size=size.small)
    
    // ─── 9 Factors ───
    // Factor 1: MA
    ma_signal = ma_diff_pct > 0.5 ? "Bullish" : ma_diff_pct < -0.5 ? "Bearish" : "Neutral"
    ma_color = ma_diff_pct > 0.5 ? color.new(#22c55e, 0) : ma_diff_pct < -0.5 ? color.new(#ef4444, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 4, "1️⃣ MA", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 4, ma_signal + " (" + str.tostring(ma_diff_pct, "#.##") + "%)", text_color=ma_color, text_size=size.tiny)
    
    // Factor 2: Volume
    vol_signal = volume_ratio > 1.5 ? "High" : volume_ratio > 1.2 ? "Normal" : volume_ratio < 0.8 ? "Low" : "Weak"
    vol_color = volume_ratio > 1.5 ? color.new(#22c55e, 0) : volume_ratio < 0.8 ? color.new(#ef4444, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 5, "2️⃣ Volume", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 5, vol_signal + " (" + str.tostring(volume_ratio, "#.##") + "x)", text_color=vol_color, text_size=size.tiny)
    
    // Factor 3: RSI
    rsi_label = rsi_value >= 70 ? "OB" : rsi_value <= 30 ? "OS" : "Neutral"
    rsi_color = rsi_value >= 70 ? color.new(#ef4444, 0) : rsi_value <= 30 ? color.new(#22c55e, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 6, "3️⃣ RSI", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 6, str.tostring(rsi_value, "#.#") + " " + rsi_label, text_color=rsi_color, text_size=size.tiny)
    
    // Factor 4: ADX
    adx_label = adx_value >= 25 ? "Strong" : adx_value >= 15 ? "Moderate" : "Weak"
    adx_color = adx_value >= 25 ? color.new(#22c55e, 0) : adx_value >= 15 ? color.new(#fbbf24, 0) : color.new(#ef4444, 0)
    table.cell(factors, 0, 7, "4️⃣ ADX", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 7, str.tostring(adx_value, "#.#") + " " + adx_label + " " + adx_direction, text_color=adx_color, text_size=size.tiny)
    
    // Factor 5: MACD
    macd_label = macd_trend
    macd_color = macd_trend == "strong_bullish" ? color.new(#22c55e, 0) : macd_trend == "bullish" ? color.new(#86efac, 0) : macd_trend == "strong_bearish" ? color.new(#ef4444, 0) : macd_trend == "bearish" ? color.new(#fca5a5, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 8, "5️⃣ MACD", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 8, macd_label, text_color=macd_color, text_size=size.tiny)
    
    // Factor 6: ATR
    atr_label = atr_pct > 5.0 ? "Extreme" : atr_pct > 3.0 ? "High" : atr_pct < 1.0 ? "Low" : "Normal"
    atr_color = atr_pct > 3.0 ? color.new(#ef4444, 0) : atr_pct < 1.0 ? color.new(#22c55e, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 9, "6️⃣ ATR", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 9, atr_label + " (" + str.tostring(atr_pct, "#.##") + "%)", text_color=atr_color, text_size=size.tiny)
    
    // Factor 7: Bollinger Bands
    bb_label = bb_squeeze
    bb_color = bb_squeeze == "tight" or bb_squeeze == "extreme" ? color.new(#fbbf24, 0) : bb_squeeze == "expanding" ? color.new(#22c55e, 0) : color.new(#94a3b8, 0)
    table.cell(factors, 0, 10, "7️⃣ BB", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 10, str.tostring(bb_percent_b, "#.##") + " " + bb_label, text_color=bb_color, text_size=size.tiny)
    
    // Factor 8: Stochastic
    stoch_label = stoch_signal
    stoch_color = stoch_signal == "overbought" ? color.new(#ef4444, 0) : stoch_signal == "oversold" ? color.new(#22c55e, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 11, "8️⃣ Stoch", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 11, str.tostring(stoch_k, "#.#") + "/" + str.tostring(stoch_d, "#.#") + " " + stoch_label, text_color=stoch_color, text_size=size.tiny)
    
    // Synergy indicator
    synergy_text = agree_count >= 4 ? "✅ " + str.tostring(agree_count, "#") + "/6 agree" : "⚠️ " + str.tostring(agree_count, "#") + "/6 agree"
    synergy_color = agree_count >= 4 ? color.new(#22c55e, 0) : color.new(#fbbf24, 0)
    table.cell(factors, 0, 12, "9️⃣ Synergy", text_color=color.new(#f8fafc, 0), text_size=size.tiny)
    table.cell(factors, 1, 12, synergy_text, text_color=synergy_color, text_size=size.tiny)

// ─── Signal Label (v1.1: simplified) ───────────────────────────

if show_signal_label and barstate.islast
    label.new(bar_index, high, signal_text + "\n" + str.tostring(confidence, "#") + "% conf", color=base_trend == 1 ? color.new(#22c55e, 20) : base_trend == -1 ? color.new(#ef4444, 20) : color.new(#fbbf24, 20), text_color=color.white, style=label.style_label_down, textsize=size.small)

// ─── Confidence Table (bottom-right) ───────────────────────────

if show_confidence and barstate.islast
    var table conf_table = table.new(position.bottom_right, 2, 4, bgcolor=color.new(#1e293b, 10), border_color=color.new(#475569, 50), border_width=1)
    
    table.cell(conf_table, 0, 0, "Confidence", text_color=color.new(#f8fafc, 0), text_size=size.small, bgcolor=color.new(#0f172a, 10))
    table.cell(conf_table, 1, 0, str.tostring(confidence, "#") + "%", text_color=confidence >= 50 ? color.new(#22c55e, 0) : confidence >= 25 ? color.new(#fbbf24, 0) : color.new(#ef4444, 0), text_size=size.small)
    
    table.cell(conf_table, 0, 1, "Strength", text_color=color.new(#f8fafc, 0), text_size=size.small)
    table.cell(conf_table, 1, 1, str.tostring(total_strength, "#") + "%", text_color=total_strength >= 70 ? color.new(#22c55e, 0) : total_strength >= 40 ? color.new(#fbbf24, 0) : color.new(#ef4444, 0), text_size=size.small)
    
    table.cell(conf_table, 0, 2, "Confirmations", text_color=color.new(#f8fafc, 0), text_size=size.small)
    table.cell(conf_table, 1, 2, str.tostring(confirmation_count, "#") + "/6", text_color=confirmation_count >= 4 ? color.new(#22c55e, 0) : confirmation_count >= 2 ? color.new(#fbbf24, 0) : color.new(#ef4444, 0), text_size=size.small)
    
    table.cell(conf_table, 0, 3, "Synergy", text_color=color.new(#f8fafc, 0), text_size=size.small)
    table.cell(conf_table, 1, 3, agree_count >= 4 ? "✅ Active" : "❌ Inactive", text_color=agree_count >= 4 ? color.new(#22c55e, 0) : color.new(#ef4444, 0), text_size=size.small)

// ─── Alerts ─────────────────────────────────────────────────────

alertcondition(base_trend == 1 and base_trend[1] != 1, title="Uptrend Start", message="Ocean Wave: Uptrend detected")
alertcondition(base_trend == -1 and base_trend[1] != -1, title="Downtrend Start", message="Ocean Wave: Downtrend detected")
alertcondition(base_trend == 0 and base_trend[1] != 0, title="Neutral Start", message="Ocean Wave: Neutral/consolidation detected")
alertcondition(confidence >= 70 and confidence[1] < 70, title="High Confidence", message="Ocean Wave: Confidence crossed 70%")
alertcondition(total_strength >= 80 and total_strength[1] < 80, title="High Strength", message="Ocean Wave: Strength crossed 80%")
alertcondition(agree_count >= 4 and agree_count[1] < 4, title="Synergy Activated", message="Ocean Wave: 4+ indicators in synergy")