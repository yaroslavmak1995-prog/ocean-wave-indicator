//@version=6
indicator("Ocean Wave — Trend Visualizer 🌊", shorttitle="Ocean Wave", overlay=true, max_lines_count=500, max_labels_count=50, max_boxes_count=50)

// ════════════════════════════════════════════════════════════════
// OCEAN WAVE — Trend Visualizer v3.2
// 
// v3.2: Performance + Auto-Preset + Dynamic HTF Tint
// v3.1: Multi-Timeframe + Color Transitions + Preset Dropdowns
// v3.0: Complete repackage as Trend Visualizer (ocean wave metaphor)
// 
// See the market like ocean waves.
// Bullish = rising tide. Bearish = undertow.
// 9 factors fused into 1 visual. No patterns to learn.
// Just the flow of the market, visualized.
// ════════════════════════════════════════════════════════════════
//
// ─── ALERT SUMMARY ─────────────────────────────────────────────
//  #  | Alert Name                      | Trigger
// ----|---------------------------------|-------------------------------------------
//  1  | 🌊 Tide Rising                  | Zone turns bullish (from neutral/bearish)
//  2  | 🌀 Undertow                     | Zone turns bearish (from neutral/bullish)
//  3  | 🔄 Tide Shift                    | Any zone change
//  4  | ⚡ Strong Current                | Confidence crosses above 70
//  5  | 🔥 High Energy                   | Total strength crosses above 80
//  6  | 🌊 Wave Alignment                | 4+ factors agree (synergy)
//  7  | 📊 HTF Trend Change              | Higher timeframe trend changes
//  8  | 📊 HTF Tide Rising               | HTF turns bullish
//  9  | 📊 HTF Undertow                  | HTF turns bearish
// 10  | Confidence Cross Up              | Confidence crosses above threshold
// 11  | Confidence Cross Down            | Confidence crosses below threshold
// ──────────────────────────────────────────────────────────────

// ─── INPUTS ────────────────────────────────────────────────────

// MA Settings
ma_fast_len = input.int(20, "MA Fast Length", minval=5, maxval=50, group="Moving Averages")
ma_slow_len = input.int(50, "MA Slow Length", minval=10, maxval=200, group="Moving Averages")

// RSI Settings
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50, group="Momentum")
rsi_ob = input.int(70, "RSI Overbought", minval=50, maxval=95, group="Momentum")
rsi_os = input.int(30, "RSI Oversold", minval=5, maxval=50, group="Momentum")

// ADX Settings
adx_len = input.int(14, "ADX Length", minval=5, maxval=50, group="Trend Strength")

// MACD Settings
macd_fast = input.int(12, "MACD Fast", minval=5, maxval=30, group="Momentum")
macd_slow = input.int(26, "MACD Slow", minval=10, maxval=50, group="Momentum")
macd_signal_len = input.int(9, "MACD Signal", minval=3, maxval=20, group="Momentum")

// Bollinger Bands Settings
bb_len = input.int(20, "BB Length", minval=5, maxval=50, group="Volatility")
bb_mult = input.float(2.0, "BB StdDev", minval=0.5, maxval=4.0, step=0.1, group="Volatility")

// Stochastic Settings
stoch_k_len = input.int(14, "Stochastic %K Length", minval=5, maxval=50, group="Oscillator")
stoch_d_len = input.int(3, "Stochastic %D Smoothing", minval=1, maxval=10, group="Oscillator")
stoch_smooth = input.int(3, "Stochastic Smooth", minval=1, maxval=10, group="Oscillator")

// Preset Dropdown — now with Auto option
preset = input.string("Auto", "Preset", options=["Auto", "Default", "Scalping", "Swing", "Position"], group="🎯 Preset")
auto_detect_text = preset == "Auto" ? "Auto-detect from chart timeframe" : "Manual override"
// Subtle hint via tooltip-like display using a dummy plot

// Multi-Timeframe Settings
use_mtf = input.bool(false, "Show Higher Timeframe Trend", group="📊 Multi-Timeframe")
htf_timeframe = input.timeframe("D", "Higher Timeframe", group="📊 Multi-Timeframe")
show_mtf_label = input.bool(true, "Show HTF Label", group="📊 Multi-Timeframe")
show_mtf_bg = input.bool(true, "Show HTF Background Tint", group="📊 Multi-Timeframe")

// Visualization Settings
show_wave = input.bool(true, "Show Wave Visualization", group="🌊 Wave Display")
wave_intensity = input.float(1.5, "Wave Intensity (height multiplier)", minval=0.5, maxval=3.0, step=0.1, group="🌊 Wave Display")
show_ma_lines = input.bool(false, "Show MA Lines", group="🌊 Wave Display")
show_label = input.bool(true, "Show Trend Label", group="🌊 Wave Display")
use_color_transitions = input.bool(true, "Smooth Color Transitions", group="🌊 Wave Display")

// Color palette — Ocean theme
color_bullish_1 = input.color(#06b6d4, "Bullish Wave (Cyan)", group="🎨 Colors")
color_bullish_2 = input.color(#0891b2, "Bullish Wave Deep (Teal)", group="🎨 Colors")
color_bearish_1 = input.color(#6366f1, "Bearish Wave (Indigo)", group="🎨 Colors")
color_bearish_2 = input.color(#3730a3, "Bearish Wave Deep (Violet)", group="🎨 Colors")
color_neutral_1 = input.color(#64748b, "Neutral Wave (Slate)", group="🎨 Colors")
color_neutral_2 = input.color(#475569, "Neutral Wave Deep", group="🎨 Colors")

// Confidence Thresholds
conf_high = input.int(50, "High Confidence Threshold", group="Algorithm")
conf_low = input.int(25, "Low Confidence Threshold", group="Algorithm")

// Confidence Smoothing
use_confidence_smoothing = input.bool(true, "Enable Confidence Smoothing (EMA)", group="Algorithm")
confidence_ema_len = input.int(3, "Confidence EMA Length", minval=1, maxval=10, group="Algorithm")
max_conf_change = input.int(20, "Max Confidence Change Per Bar (pp)", minval=5, maxval=50, group="Algorithm")

// ─── PRESET AUTO-DETECTION ─────────────────────────────────────
// Auto-detect preset from chart timeframe
// 1m-5m → Scalping, 15m-1H → Swing, 4H-1D+ → Position
_tf_period = timeframe.period
_auto_preset = _tf_period == "1" or _tf_period == "3" or _tf_period == "5" ? "Scalping" : 
   _tf_period == "15" or _tf_period == "30" or _tf_period == "45" or _tf_period == "60" or _tf_period == "120" ? "Swing" : 
   "Position"

_effective_preset = preset == "Auto" ? _auto_preset : preset

// Apply preset-specific parameter overrides
_preset_fast = _effective_preset == "Scalping" ? 9 : _effective_preset == "Swing" ? 20 : _effective_preset == "Position" ? 50 : ma_fast_len
_preset_slow = _effective_preset == "Scalping" ? 21 : _effective_preset == "Swing" ? 50 : _effective_preset == "Position" ? 200 : ma_slow_len
_preset_rsi = _effective_preset == "Scalping" ? 7 : _effective_preset == "Swing" ? 14 : _effective_preset == "Position" ? 21 : rsi_len
_preset_adx = _effective_preset == "Scalping" ? 10 : _effective_preset == "Swing" ? 14 : _effective_preset == "Position" ? 20 : adx_len
_preset_wave = _effective_preset == "Scalping" ? 1.0 : _effective_preset == "Swing" ? 1.5 : _effective_preset == "Position" ? 2.5 : wave_intensity

// Use preset values
ma_fast_len_eff = _preset_fast
ma_slow_len_eff = _preset_slow
rsi_len_eff = _preset_rsi
adx_len_eff = _preset_adx
wave_intensity_eff = _preset_wave

// ─── CALCULATIONS ──────────────────────────────────────────────

// STEP 1: MA Crossover
ma_fast = ta.sma(close, ma_fast_len_eff)
ma_slow = ta.sma(close, ma_slow_len_eff)
ma_diff_pct = (ma_fast - ma_slow) / ma_slow * 100

base_trend = ma_diff_pct > 0.5 ? 1 : ma_diff_pct < -0.5 ? -1 : 0

// STEP 2: Volume Confirmation
avg_volume = ta.sma(volume, 20)
volume_ratio = avg_volume > 0 ? volume / avg_volume : 1.0

volume_bonus = volume_ratio > 2.0 ? 15 : volume_ratio > 1.5 ? 10 : volume_ratio > 1.2 ? 5 : volume_ratio < 0.5 ? -10 : volume_ratio < 0.8 ? -5 : 0

// STEP 3: Momentum Check
momentum_pct = ma_fast > 0 ? (close - ma_fast) / ma_fast * 100 : 0
momentum_bonus = math.abs(momentum_pct) > 3 ? 10 : math.abs(momentum_pct) > 1.5 ? 5 : math.abs(momentum_pct) < 0.5 ? -5 : 0

// Base strength
base_strength = math.abs(ma_diff_pct) * 15
total_strength_raw = base_strength + volume_bonus + momentum_bonus
total_strength = math.min(100, math.max(0, total_strength_raw))

// STEP 4: RSI
rsi_value = ta.rsi(close, rsi_len_eff)

rsi_bonus = 0
if rsi_value >= rsi_ob
    rsi_bonus := base_trend == 1 ? -10 : base_trend == -1 ? 15 : 0
else if rsi_value <= rsi_os
    rsi_bonus := base_trend == -1 ? -10 : base_trend == 1 ? 15 : 0
else if rsi_value >= 60
    rsi_bonus := base_trend == 1 ? 5 : base_trend == -1 ? -5 : 0
else if rsi_value <= 40
    rsi_bonus := base_trend == -1 ? 5 : base_trend == 1 ? -5 : 0
else
    rsi_bonus := 0

// STEP 5: ADX
[diplus, diminus, adx_value] = ta.dmi(adx_len_eff, adx_len_eff)

adx_direction = diplus > diminus ? "bullish" : diplus < diminus ? "bearish" : "neutral"
adx_bonus = 0
if adx_value >= 25
    if adx_direction == "bullish" and base_trend == 1
        adx_bonus := 15
    else if adx_direction == "bearish" and base_trend == -1
        adx_bonus := 15
    else if adx_direction != "neutral" and base_trend == 0
        adx_bonus := 5
    else
        adx_bonus := -5
else if adx_value >= 15
    adx_bonus := 0
else
    adx_bonus := -15

// STEP 6: MACD
[macd_line, macd_signal_line, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_signal_len)

macd_cross_up = ta.crossover(macd_line, macd_signal_line)
macd_cross_down = ta.crossunder(macd_line, macd_signal_line)
macd_crossover = macd_cross_up ? "bullish" : macd_cross_down ? "bearish" : "none"

macd_trend = macd_line > macd_signal_line and macd_line > 0 ? "strong_bullish" : macd_line > macd_signal_line ? "bullish" : macd_line < macd_signal_line and macd_line < 0 ? "strong_bearish" : macd_line < macd_signal_line ? "bearish" : "neutral"

macd_bonus = 0
if macd_trend == "strong_bullish" and base_trend == 1
    macd_bonus := 15
else if macd_trend == "bullish" and base_trend == 1
    macd_bonus := 10
else if macd_trend == "strong_bearish" and base_trend == -1
    macd_bonus := 15
else if macd_trend == "bearish" and base_trend == -1
    macd_bonus := 10
else if macd_trend == "neutral" and base_trend == 0
    macd_bonus := 3
else
    macd_bonus := -10

// STEP 7: ATR
atr_value = ta.atr(14)
atr_pct = atr_value / close * 100

atr_bonus = 0
if atr_pct > 5.0
    atr_bonus := -15
else if atr_pct > 3.0
    atr_bonus := -8
else if atr_pct < 1.0
    atr_bonus := 3
else
    atr_bonus := 0

atr_trend = atr_value > atr_value[1] ? "rising" : atr_value < atr_value[1] ? "falling" : "stable"

if atr_trend == "rising" and base_trend != 0
    atr_bonus := atr_bonus - 3
else if atr_trend == "falling" and base_trend != 0
    atr_bonus := atr_bonus + 2

// STEP 8: Bollinger Bands
bb_basis = ta.sma(close, bb_len)
bb_dev = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

bb_range = bb_upper - bb_lower
bb_percent_b = bb_range > 0 ? (close - bb_lower) / bb_range : 0.5
bb_bandwidth = bb_basis > 0 ? bb_range / bb_basis * 100 : 0

bb_squeeze = bb_bandwidth < 3 ? "extreme" : bb_bandwidth < 5 ? "tight" : bb_bandwidth > 10 ? "expanding" : "normal"

bb_bonus = 0
if bb_percent_b >= 1.0 or bb_percent_b <= 0.0
    bb_bonus := -8
else if bb_percent_b >= 0.85 or bb_percent_b <= 0.15
    bb_bonus := -3

if bb_squeeze == "extreme" or bb_squeeze == "tight"
    bb_bonus := bb_bonus - 5
else if bb_squeeze == "expanding" and base_trend != 0
    bb_bonus := bb_bonus + 4

if (base_trend == 1 and bb_percent_b > 0.6) or (base_trend == -1 and bb_percent_b < 0.4)
    bb_bonus := bb_bonus + 3

// STEP 9: Stochastic Oscillator
stoch_lowest = ta.lowest(low, stoch_k_len)
stoch_highest = ta.highest(high, stoch_k_len)
stoch_range = stoch_highest - stoch_lowest
stoch_k_raw = stoch_range > 0 ? 100 * (close - stoch_lowest) / stoch_range : 50
stoch_k = ta.sma(stoch_k_raw, stoch_smooth)
stoch_d = ta.sma(stoch_k, stoch_d_len)

stoch_cross_up = ta.crossover(stoch_k, stoch_d)
stoch_cross_down = ta.crossunder(stoch_k, stoch_d)
stoch_crossover = stoch_cross_up ? "bullish" : stoch_cross_down ? "bearish" : "none"

stoch_signal = stoch_k >= 80 ? "overbought" : stoch_k <= 20 ? "oversold" : stoch_k >= 60 ? "bullish" : stoch_k <= 40 ? "bearish" : "neutral"

stoch_bonus = 0
if stoch_signal == "overbought" and base_trend == 1
    stoch_bonus := -4
else if stoch_signal == "oversold" and base_trend == -1
    stoch_bonus := -4
else if stoch_signal == "neutral"
    stoch_bonus := 2
else if (base_trend == 1 and stoch_k > 50) or (base_trend == -1 and stoch_k < 50)
    stoch_bonus := 3
else if (base_trend == 1 and stoch_k < 30) or (base_trend == -1 and stoch_k > 70)
    stoch_bonus := -4

if stoch_cross_up and (base_trend == 1 or base_trend == 0)
    stoch_bonus := stoch_bonus + 3
else if stoch_cross_down and (base_trend == -1 or base_trend == 0)
    stoch_bonus := stoch_bonus + 3

// ─── AGGREGATE: Total Strength ─────────────────────────────────

total_strength := math.min(100, math.max(0, total_strength + rsi_bonus + adx_bonus + macd_bonus + atr_bonus + bb_bonus + stoch_bonus))

// ─── Synergy Bonus ─────────────────────────────────────────────

agree_count = 0
if base_trend == 1 and rsi_value >= 50
    agree_count := agree_count + 1
else if base_trend == -1 and rsi_value <= 50
    agree_count := agree_count + 1

if (base_trend == 1 and adx_direction == "bullish") or (base_trend == -1 and adx_direction == "bearish")
    agree_count := agree_count + 1

macd_agrees = (base_trend == 1 and (macd_trend == "strong_bullish" or macd_trend == "bullish")) or (base_trend == -1 and (macd_trend == "strong_bearish" or macd_trend == "bearish"))
if macd_agrees
    agree_count := agree_count + 1

if atr_pct <= 3.0 and base_trend != 0
    agree_count := agree_count + 1

if (base_trend == 1 and bb_percent_b > 0.5) or (base_trend == -1 and bb_percent_b < 0.5)
    agree_count := agree_count + 1

if (base_trend == 1 and stoch_k > 50) or (base_trend == -1 and stoch_k < 50)
    agree_count := agree_count + 1

synergy_bonus = agree_count >= 4 ? 10 : 0

// ─── Confirmation Count & Confidence Floor ──────────────────────

confirmation_count = 0
if rsi_bonus >= 0
    confirmation_count := confirmation_count + 1
if adx_bonus >= 0
    confirmation_count := confirmation_count + 1
if macd_bonus >= 0
    confirmation_count := confirmation_count + 1
if atr_bonus >= 0
    confirmation_count := confirmation_count + 1
if bb_bonus >= 0
    confirmation_count := confirmation_count + 1
if stoch_bonus >= 0
    confirmation_count := confirmation_count + 1

if confirmation_count >= 3 and base_trend != 0
    total_strength := math.min(100, total_strength + 10)
if confirmation_count >= 5 and base_trend != 0
    total_strength := math.min(100, total_strength + 15)

// ─── Zone Calculation ─────────────────────────────────────────────

zone_color_val = base_trend == 1 ? (total_strength >= 70 ? 2 : 1) : base_trend == -1 ? (total_strength >= 70 ? -2 : -1) : 0

// ─── MULTI-TIMEFRAME (MTF) ANALYSIS ──────────────────────────────
// Higher timeframe trend context for intraday traders
// v3.2: Combined into single request.security() tuple call for performance

[htf_ma_fast, htf_ma_slow, htf_rsi, htf_diplus, htf_diminus, htf_adx_val] = request.security(syminfo.tickerid, htf_timeframe, [
  ta.sma(close, ma_fast_len_eff),
  ta.sma(close, ma_slow_len_eff),
  ta.rsi(close, rsi_len_eff),
  ta.dmi(adx_len_eff, adx_len_eff)
])
htf_ma_diff = (htf_ma_fast - htf_ma_slow) / htf_ma_slow * 100
htf_base_trend = htf_ma_diff > 0.5 ? 1 : htf_ma_diff < -0.5 ? -1 : 0
htf_strength = math.min(100, math.abs(htf_ma_diff) * 15 + 30)

htf_trend_text = htf_base_trend == 1 ? "HTF Rising Tide" : htf_base_trend == -1 ? "HTF Undertow" : "HTF Calm"
htf_trend_emoji = htf_base_trend == 1 ? "🌊" : htf_base_trend == -1 ? "🌀" : "~"

// v3.2: Dynamic HTF background tint transparency based on HTF strength
// Stronger HTF trend = more visible tint (but still subtle: 88-95% transparency)
htf_tint_transp = htf_base_trend == 0 ? 95 : math.max(88, 95 - math.round(htf_strength / 12))
htf_bg_color = htf_base_trend == 1 ? color.new(#06b6d4, htf_tint_transp) : htf_base_trend == -1 ? color.new(#6366f1, htf_tint_transp) : color.new(#64748b, 95)

// HTF background tint
bgcolor(show_mtf_bg and use_mtf ? htf_bg_color : na, title="HTF Trend Background")

// HTF Label (separate from main label)
var label htf_label = na
if show_mtf_label and use_mtf and barstate.islast
    htf_label_text = htf_trend_emoji + " " + htf_trend_text + " (" + str.tostring(math.round(htf_strength)) + "%)"
    if na(htf_label)
        htf_label := label.new(bar_index - 30, high + atr_value * 2.5, htf_label_text, color=color.new(htf_base_trend == 1 ? #06b6d4 : htf_base_trend == -1 ? #6366f1 : #64748b, 70), textcolor=color.white, style=label.style_label_left, size=size.small)
    else
        label.set_text(htf_label, htf_label_text)
        label.set_color(htf_label, color.new(htf_base_trend == 1 ? #06b6d4 : htf_base_trend == -1 ? #6366f1 : #64748b, 70))
        label.set_xy(htf_label, bar_index - 30, high + atr_value * 2.5)

// ─── Confidence Calculation (internal only, not displayed) ──────

confidence_raw = math.min(100, math.max(0, total_strength))

if bar_index >= 100
    confidence_raw := confidence_raw + 5
else if bar_index < 50
    confidence_raw := confidence_raw - 10

if volume_ratio > 1.5
    confidence_raw := confidence_raw + 5
else if volume_ratio < 0.8
    confidence_raw := confidence_raw - 10

if rsi_value >= rsi_ob or rsi_value <= rsi_os
    if (rsi_value >= rsi_ob and base_trend == -1) or (rsi_value <= rsi_os and base_trend == 1)
        confidence_raw := confidence_raw + 15
    else
        confidence_raw := confidence_raw - 5

if adx_value >= 25
    confidence_raw := confidence_raw + 10
else if adx_value < 10
    confidence_raw := confidence_raw - 15

if (macd_trend == "strong_bullish" and base_trend == 1) or (macd_trend == "strong_bearish" and base_trend == -1)
    confidence_raw := confidence_raw + 8
else if macd_cross_up and (base_trend == 1 or base_trend == 0)
    confidence_raw := confidence_raw + 5
else if macd_cross_down and (base_trend == -1 or base_trend == 0)
    confidence_raw := confidence_raw + 5

if atr_pct > 5.0
    confidence_raw := confidence_raw - 12
else if atr_pct > 3.0
    confidence_raw := confidence_raw - 6
else if atr_pct < 1.0
    confidence_raw := confidence_raw + 3

if bb_percent_b >= 1.0 or bb_percent_b <= 0.0
    confidence_raw := confidence_raw - 8
else if bb_percent_b >= 0.85 or bb_percent_b <= 0.15
    confidence_raw := confidence_raw - 3

if bb_squeeze == "extreme" or bb_squeeze == "tight"
    confidence_raw := confidence_raw - 5
else if bb_squeeze == "expanding" and base_trend != 0
    confidence_raw := confidence_raw + 4

if (base_trend == 1 and bb_percent_b > 0.6) or (base_trend == -1 and bb_percent_b < 0.4)
    confidence_raw := confidence_raw + 3

if stoch_signal == "overbought" and base_trend == 1
    confidence_raw := confidence_raw - 4
else if stoch_signal == "oversold" and base_trend == -1
    confidence_raw := confidence_raw - 4
else if stoch_signal == "neutral"
    confidence_raw := confidence_raw + 2

if (base_trend == 1 and stoch_k > 50) or (base_trend == -1 and stoch_k < 50)
    confidence_raw := confidence_raw + 3
else if (base_trend == 1 and stoch_k < 30) or (base_trend == -1 and stoch_k > 70)
    confidence_raw := confidence_raw - 4

if (stoch_cross_up and (base_trend == 1 or base_trend == 0)) or (stoch_cross_down and (base_trend == -1 or base_trend == 0))
    confidence_raw := confidence_raw + 3

confidence_raw := confidence_raw + synergy_bonus

if confirmation_count >= 3 and base_trend != 0
    confidence_raw := math.max(confidence_raw, 25)
if confirmation_count >= 5 and base_trend != 0
    confidence_raw := math.max(confidence_raw, 50)

confidence_raw := math.min(100, math.max(0, confidence_raw))

// Confidence smoothing
confidence_smoothed = use_confidence_smoothing ? ta.ema(confidence_raw, confidence_ema_len) : confidence_raw
confidence_change = confidence_smoothed - nz(confidence_smoothed[1], confidence_smoothed)
confidence_limited = confidence_change > max_conf_change ? confidence_smoothed[1] + max_conf_change : confidence_change < -max_conf_change ? confidence_smoothed[1] - max_conf_change : confidence_smoothed
confidence = math.min(100, math.max(0, confidence_limited))

// ─── WAVE VISUALIZATION ─────────────────────────────────────────
// The core innovation: ocean wave visual instead of boring bgcolor zones

// Compute wave boundaries based on price and trend strength
// Wave height proportional to trend strength — bigger waves = stronger trend
wave_height = atr_value * wave_intensity_eff * (total_strength / 100.0 + 0.3)

// Smooth the wave boundaries for organic flow
wave_top_raw = close + wave_height
wave_bottom_raw = close - wave_height

// Heavy smoothing for wave-like curves (not jagged)
wave_top = ta.ema(wave_top_raw, 8)
wave_bottom = ta.ema(wave_bottom_raw, 8)

// Secondary wave layer (deeper, slower — like ocean depth)
wave_top_deep_raw = close + wave_height * 1.6
wave_bottom_deep_raw = close - wave_height * 1.6
wave_top_deep = ta.ema(wave_top_deep_raw, 15)
wave_bottom_deep = ta.ema(wave_bottom_deep_raw, 15)

// Tertiary wave layer (deepest, slowest — like ocean floor)
wave_top_floor_raw = close + wave_height * 2.4
wave_bottom_floor_raw = close - wave_height * 2.4
wave_top_floor = ta.ema(wave_top_floor_raw, 25)
wave_bottom_floor = ta.ema(wave_bottom_floor_raw, 25)

// Determine wave colors based on trend direction
bullish_color_1 = color.new(color_bullish_1, 70)  // Surface wave — more visible
bullish_color_2 = color.new(color_bullish_2, 85)  // Deep wave — more transparent
bearish_color_1 = color.new(color_bearish_1, 70)
bearish_color_2 = color.new(color_bearish_2, 85)
neutral_color_1 = color.new(color_neutral_1, 75)
neutral_color_2 = color.new(color_neutral_2, 88)

// Select colors based on current trend
// With smooth color transitions — gradually shift between trend colors
raw_surface_color = base_trend == 1 ? bullish_color_1 : base_trend == -1 ? bearish_color_1 : neutral_color_1
raw_deep_color = base_trend == 1 ? bullish_color_2 : base_trend == -1 ? bearish_color_2 : neutral_color_2
raw_floor_color = color.new(base_trend == 1 ? color_bullish_2 : base_trend == -1 ? color_bearish_2 : color_neutral_2, 92)

// Color transition smoothing: use EMA of trend direction to create gradual shifts
// When transition_factor is between -0.3 and 0.3, we're in a transition zone
transition_factor = use_color_transitions ? ta.ema(base_trend == 1 ? 1.0 : base_trend == -1 ? -1.0 : 0.0, 5) : (base_trend == 1 ? 1.0 : base_trend == -1 ? -1.0 : 0.0)

// Blend colors based on transition factor
surface_color = use_color_transitions ? 
  (transition_factor > 0.3 ? bullish_color_1 : transition_factor < -0.3 ? bearish_color_1 : neutral_color_1) : 
  raw_surface_color
deep_color = use_color_transitions ? 
  (transition_factor > 0.3 ? bullish_color_2 : transition_factor < -0.3 ? bearish_color_2 : neutral_color_2) : 
  raw_deep_color

// Floor colors (even more transparent)
floor_color = use_color_transitions ?
  (transition_factor > 0.3 ? color.new(color_bullish_2, 92) : transition_factor < -0.3 ? color.new(color_bearish_2, 92) : color.new(color_neutral_2, 92)) :
  raw_floor_color

// ─── PLOT WAVES ─────────────────────────────────────────────────

// Surface wave (most visible, closest to price)
p_top = plot(show_wave ? wave_top : na, title="Wave Surface Top", color=color.new(surface_color, 50), linewidth=1)
p_bot = plot(show_wave ? wave_bottom : na, title="Wave Surface Bottom", color=color.new(surface_color, 50), linewidth=1)
fill(p_top, p_bot, title="Wave Surface", color=surface_color)

// Deep wave (larger, more transparent — gives depth)
p_top_deep = plot(show_wave ? wave_top_deep : na, title="Wave Deep Top", color=color.new(deep_color, 60), linewidth=1)
p_bot_deep = plot(show_wave ? wave_bottom_deep : na, title="Wave Deep Bottom", color=color.new(deep_color, 60), linewidth=1)
fill(p_top_deep, p_bot_deep, title="Wave Deep", color=deep_color)

// Floor wave (largest, most transparent — ocean floor)
p_top_floor = plot(show_wave ? wave_top_floor : na, title="Wave Floor Top", color=color.new(floor_color, 70), linewidth=1)
p_bot_floor = plot(show_wave ? wave_bottom_floor : na, title="Wave Floor Bottom", color=color.new(floor_color, 70), linewidth=1)
fill(p_top_floor, p_bot_floor, title="Wave Floor", color=floor_color)

// MA Lines (optional, off by default)
plot(show_ma_lines ? ma_fast : na, "MA Fast", color=color.new(#06b6d4, 20), linewidth=1)
plot(show_ma_lines ? ma_slow : na, "MA Slow", color=color.new(#6366f1, 20), linewidth=1)

// ─── TREND LABEL (minimal, clean) ───────────────────────────────

// Simple label — just direction, no numbers
trend_emoji = base_trend == 1 ? "🌊" : base_trend == -1 ? "🌀" : "~"
trend_text = base_trend == 1 ? (total_strength >= 70 ? "Rising Tide" : "Flowing Up") : base_trend == -1 ? (total_strength >= 70 ? "Undertow" : "Falling") : "Calm Waters"

// v3.2: Label includes active preset name for Auto mode
_preset_display = _effective_preset == "Scalping" ? "⚡" : _effective_preset == "Swing" ? "📊" : _effective_preset == "Position" ? "🎯" : ""
if show_label and barstate.islast
    label.new(bar_index, high + atr_value * 0.5, trend_emoji + " " + trend_text + (_effective_preset != "Default" ? " " + _preset_display : ""), color=color.new(base_trend == 1 ? #06b6d4 : base_trend == -1 ? #6366f1 : #64748b, 50), textcolor=color.white, style=label.style_label_down, size=size.small)

// ─── ZONE CHANGE TRACKING ───────────────────────────────────────

zone_changed = zone_color_val != nz(zone_color_val[1], zone_color_val)
zone_to_bearish = zone_color_val < 0 and nz(zone_color_val[1], 0) >= 0
zone_to_bullish = zone_color_val > 0 and nz(zone_color_val[1], 0) <= 0

// ─── ALERTS (ocean-themed copy) ─────────────────────────────────

alertcondition(zone_to_bullish, title="🌊 Tide Rising — Uptrend Detected", message="Ocean Wave: The tide is rising — bullish trend context detected")
alertcondition(zone_to_bearish, title="🌀 Undertow — Downtrend Detected", message="Ocean Wave: Undertow pulling down — bearish trend context detected")
alertcondition(zone_changed, title="🔄 Tide Shift — Trend Change", message="Ocean Wave: The tide is shifting — trend context changed")
alertcondition(confidence >= 70 and confidence[1] < 70, title="⚡ Strong Current — High Confidence", message="Ocean Wave: Strong current detected — high confidence trend")
alertcondition(total_strength >= 80 and total_strength[1] < 80, title="🔥 High Energy — Strong Trend", message="Ocean Wave: High energy in the market — strong trend detected")
alertcondition(agree_count >= 4 and agree_count[1] < 4, title="🌊 Wave Alignment — 4+ Factors Agree", message="Ocean Wave: Multiple factors aligned — wave convergence detected")

// MTF alerts
htf_trend_changed = htf_base_trend != nz(htf_base_trend[1], htf_base_trend)
alertcondition(use_mtf and htf_trend_changed, title="📊 HTF Trend Change — Higher Timeframe Shift", message="Ocean Wave: Higher timeframe trend has changed — check your position against the bigger picture")
alertcondition(use_mtf and htf_base_trend == 1 and htf_base_trend[1] <= 0, title="📊 HTF Tide Rising — Daily Bullish", message="Ocean Wave: Higher timeframe turning bullish — trend alignment opportunity")
alertcondition(use_mtf and htf_base_trend == -1 and htf_base_trend[1] >= 0, title="📊 HTF Undertow — Daily Bearish", message="Ocean Wave: Higher timeframe turning bearish — caution advised")

// Confidence threshold alerts (configurable)
conf_thresh = input.int(50, "Alert: Confidence Threshold", minval=10, maxval=90, group="Algorithm")
alertcondition(confidence >= conf_thresh and confidence[1] < conf_thresh, title="Confidence Cross Up", message="Ocean Wave: Confidence crossed above threshold")
alertcondition(confidence < conf_thresh and confidence[1] >= conf_thresh, title="Confidence Cross Down", message="Ocean Wave: Confidence crossed below threshold")